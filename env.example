# Copy this file to an untracked local environment file and replace placeholders.
# Do not commit machine-specific absolute paths.

ADAPTDRIVE_ROOT=/path/to/AdaptDrive
ADAPTDRIVE_ASSET_ROOT=/path/to/AdaptDrive-assets
ADAPTDRIVE_RUN_ROOT=/path/to/AdaptDrive-runs
EXPERIMENT_ID=adaptdrive-example

HIPAD_ROOT=/path/to/AdaptDrive/HiP-AD
HIPAD_CONFIG=/path/to/AdaptDrive/HiP-AD/local_runtime/hipad_b2d_stage2_clean_local.py
HIPAD_BASE_CKPT=/path/to/AdaptDrive-assets/hipad/checkpoints/hipad_b2d_stage2_base.pth
# Required only for standalone HiP-AD stage-2 offline training.
HIPAD_STAGE1_CKPT=/path/to/external/hipad_b2d_stage1_checkpoint.pth
ADAPTDRIVE_PARENT_CKPT=/path/to/AdaptDrive-assets/adaptdrive/checkpoints/adaptdrive_sig7_step140906.pt
ROACH_BEV_MAP_ROOT=/path/to/AdaptDrive-assets/roach_bev_maps

B2D_ROOT=/path/to/AdaptDrive/Bench2Drive
B2DZOO_ROOT=/path/to/AdaptDrive/Bench2DriveZoo
CARLA_ROOT=/path/to/CARLA
# Leave empty to use the DCNv4 wheel installed from third_party/DCNv4.
# Set only to test an alternative package root that already contains a built extension.
DCNV4_ROOT=

# Canonical launchers derive all generated paths from ADAPTDRIVE_RUN_ROOT and
# EXPERIMENT_ID. Do not override checkpoint, replay, log or evaluation roots.
